{
  "name": "@myvue/runtime-dom",
  "version": "1.0.0",
  "description": "Runtime DOM utils for Vue 3",
  "type": "module",
  "main": "index.js",
  "module": "dist/index.js",
  "types": "dist/runtime-dom.d.ts",
  "scripts": {
    "dev:ts": "tsc -w"
  },
  "buildOptions": {
    "name": "RuntimeDom",
    "format": [
      "esm-bundle",
      "esm-browser",
      "cjs",
      "global"
    ]
  },
  "dependencies": {
    "@myvue/runtime-core": "workspace:*",
    "@myvue/shared": "workspace:*"
  }
}
