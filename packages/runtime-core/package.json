{
  "name": "@myvue/runtime-core",
  "version": "1.0.0",
  "description": "Runtime core utils for Vue 3",
  "type": "module",
  "types": "dist/runtime-core.d.ts",
  "main": "index.js",
  "module": "src/index.ts",
  "unpkg": "dist/runtime-core.global.js",
  "scripts": {
    "dev:ts": "tsc -w",
    "dts": "dts-bundle-generator -o dist/runtime-core.d.ts src/index.ts --no-check"
  },
  "buildOptions": {
    "name": "RuntimeCore",
    "format": [
      "esm-bundle",
      "esm-browser",
      "cjs",
      "global"
    ]
  },
  "dependencies": {
    "@myvue/reactivity": "workspace:*",
    "@myvue/shared": "workspace:*"
  }
}
