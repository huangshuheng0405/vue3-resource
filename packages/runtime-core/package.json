{
  "name": "@myvue/runtime-core",
  "version": "1.0.0",
  "description": "Runtime core utils for Vue 3",
  "type": "module",
  "types": "dist/types/index.d.ts",
  "main": "index.js",
  "module": "dist/runtime-core.mjs",
  "unpkg": "dist/runtime-core.global.js",
  "scripts": {
    "dev:ts": "tsc -w",
    "build": "node build.js"
  },
  "buildOptions": {
    "name": "RuntimeCore",
    "format": [
      "esm-bundle",
      "esm-browser",
      "cjs",
      "global"
    ]
  },
  "dependencies": {
    "@myvue/reactivity": "workspace:*",
    "@myvue/shared": "workspace:*"
  }
}
