{
  "name": "@myvue/reactivity",
  "version": "1.0.0",
  "description": "Reactivity utils for Vue 3",
  "type": "module",
  "main": "index.js",
  "module": "src/index.ts",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "build": "node build.js",
    "types": "tsc -p tsconfig.json"
  },
  "buildOptions": {
    "name": "VueReactivity",
    "format": [
      "esm-bundle",
      "esm-browser",
      "cjs",
      "global"
    ]
  },
  "dependencies": {
    "@myvue/shared": "workspace:*"
  }
}
